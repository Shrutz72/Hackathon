NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/community-platform
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# File upload settings
MAX_FILE_UPLOAD=1000000
FILE_UPLOAD_PATH=./uploads

# Email settings if using email notifications
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=yourmailtrapusername
EMAIL_PASSWORD=yourmailtrappassword
FROM_EMAIL=noreply@communityplatform.com
FROM_NAME=CommunityPlatform